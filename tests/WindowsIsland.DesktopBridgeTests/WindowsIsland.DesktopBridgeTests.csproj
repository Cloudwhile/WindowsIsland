<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.ComponentModel" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WindowsIsland.Contracts/WindowsIsland.Contracts.csproj" />
    <ProjectReference Include="../../src/WindowsIsland.PluginIsolation/WindowsIsland.PluginIsolation.csproj" />
    <Compile Include="../../src/WindowsIsland/Plugins/Desktop/*.cs" Link="Desktop/%(Filename)%(Extension)" />
    <Compile Include="../../src/WindowsIsland/Plugins/PluginDesktopPolicy.cs" Link="PluginDesktopPolicy.cs" />
    <Compile Include="../../src/WindowsIsland/Plugins/PluginPaths.cs" Link="PluginPaths.cs" />
    <Compile Include="../../src/WindowsIsland/Plugins/PluginFileSafety.cs" Link="PluginFileSafety.cs" />
    <Compile Include="../../src/WindowsIsland/Plugins/PluginException.cs" Link="PluginException.cs" />
  </ItemGroup>
</Project>
