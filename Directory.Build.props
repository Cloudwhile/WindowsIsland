<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.7-alpha.1</Version>
    <InformationalVersion>v$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <PublishDir>$(MSBuildThisFileDirectory)artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
