<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WindowsIsland</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icons\LOGO.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WindowsIsland.Contracts\WindowsIsland.Contracts.csproj" />
    <ProjectReference Include="..\WindowsIsland.PluginIsolation\WindowsIsland.PluginIsolation.csproj" />
    <ProjectReference Include="..\WindowsIsland.PluginWorker\WindowsIsland.PluginWorker.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="OutDir;PublishDir" />
  </ItemGroup>
  <Target Name="CopyPluginWorker" AfterTargets="Build" BeforeTargets="ComputeFilesToPublish">
    <PropertyGroup>
      <_WorkerPlatformPath Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != 'Any CPU'">$(Platform)\</_WorkerPlatformPath>
    </PropertyGroup>
    <ItemGroup>
      <_PluginWorkerFiles Include="$(MSBuildProjectDirectory)\..\..\artifacts\bin\WindowsIsland.PluginWorker\$(_WorkerPlatformPath)$(Configuration)\net10.0\win-x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginWorkerFiles)" DestinationFiles="@(_PluginWorkerFiles->'$(TargetDir)PluginWorker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_PluginWorkerFiles)">
        <RelativePath>PluginWorker\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="PublishPluginWorker" AfterTargets="Publish" DependsOnTargets="CopyPluginWorker">
    <Copy SourceFiles="@(_PluginWorkerFiles)" DestinationFiles="@(_PluginWorkerFiles->'$(PublishDir)PluginWorker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="10.0.13" />
    <KnownAppHostPack Update="Microsoft.NETCore.App" AppHostPackVersion="10.0.13" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" RuntimeFrameworkVersion="10.0.13" />
    <KnownFrameworkReference Update="Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WPF;Microsoft.WindowsDesktop.App.WindowsForms"
      LatestRuntimeFrameworkVersion="10.0.13" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260416003" />
    <PackageReference Include="Markdig" Version="1.4.2" />
    <Content Include="Licenses\Markdig.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Icons\LOGO.ico" Link="Assets\Island.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Icons\LOGO.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Icons\Shell\*.png" Link="Assets\Shell\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\AppxManifest.xml" Link="Initialization\AppxManifest.xml"
      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\Unregister-Package.ps1" Link="Unregister-Package.ps1"
      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\native\vendor\minhook\LICENSE.txt" Link="Licenses\MinHook.txt"
      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\artifacts\native\Release\WindowsIsland.TelegramHook.dll" Link="WindowsIsland.TelegramHook.dll"
      CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../packaging/TelegramHookIntegrity.targets" />
  <Target Name="PrepareInitializationRuntime" AfterTargets="Build" BeforeTargets="ComputeFilesToPublish">
    <Copy SourceFiles="$(IntermediateOutputPath)MsixContent\AppxManifest.xml"
      DestinationFiles="$(TargetDir)Initialization\RuntimeManifest.xml" SkipUnchangedFiles="true" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)Initialization\RuntimeManifest.xml">
        <RelativePath>Initialization\RuntimeManifest.xml</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="PublishWinUIResources" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_WinUICompiledXaml Include="$(TargetDir)**\*.xbf" />
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_WinUICompiledXaml)">
        <RelativePath>%(_WinUICompiledXaml.RecursiveDir)%(_WinUICompiledXaml.Filename)%(_WinUICompiledXaml.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
