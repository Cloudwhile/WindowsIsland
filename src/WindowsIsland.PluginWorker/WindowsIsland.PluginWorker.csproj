<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\publish\PluginWorker\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WindowsIsland.Contracts\WindowsIsland.Contracts.csproj" />
    <ProjectReference Include="..\WindowsIsland.PluginIsolation\WindowsIsland.PluginIsolation.csproj" />
  </ItemGroup>
</Project>
