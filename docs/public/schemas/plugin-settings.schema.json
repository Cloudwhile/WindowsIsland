{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Windows Island static settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fields"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "fields": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type",
          "title"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?![Hh][Oo][Ss][Tt]\\.)(?!\\s*$)[^\\x00-\\x1f\\x7f]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?!\\s*$)[^\\x00-\\x1f\\x7f]+$"
          },
          "type": {
            "enum": [
              "string",
              "boolean",
              "integer",
              "enum",
              "url",
              "password"
            ]
          },
          "default": {},
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "min": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          },
          "max": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          },
          "choices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "boolean"
                }
              }
            },
            "then": {
              "required": [
                "default"
              ],
              "properties": {
                "default": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "integer"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                }
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "min"
                    ]
                  },
                  {
                    "required": [
                      "max"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "enum"
                }
              }
            },
            "then": {
              "required": [
                "choices"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "choices"
                ]
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "type": {
                      "const": "password"
                    }
                  }
                },
                {
                  "required": [
                    "secret"
                  ],
                  "properties": {
                    "secret": {
                      "const": true
                    }
                  }
                }
              ]
            },
            "then": {
              "properties": {
                "type": {
                  "enum": [
                    "string",
                    "password"
                  ]
                }
              },
              "not": {
                "required": [
                  "default"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "string",
                    "enum",
                    "url"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "items": {
              "properties": {
                "type": {
                  "enum": [
                    "string",
                    "boolean"
                  ]
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "required"
                    ]
                  },
                  {
                    "required": [
                      "secret"
                    ]
                  },
                  {
                    "required": [
                      "min"
                    ]
                  },
                  {
                    "required": [
                      "max"
                    ]
                  },
                  {
                    "required": [
                      "choices"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
